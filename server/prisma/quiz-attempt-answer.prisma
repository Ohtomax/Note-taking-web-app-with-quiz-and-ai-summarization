model QuizAttemptAnswer {
  id                String       @id @default(uuid()) @db.Uuid
  attemptId         String       @db.Uuid
  questionId        String       @db.Uuid
  versionId         String       @db.Uuid
  attempt           QuizAttempt  @relation(fields: [attemptId, versionId], references: [id, versionId], onDelete: Restrict, onUpdate: NoAction)
  question          QuizQuestion @relation(fields: [questionId, versionId], references: [id, versionId], onDelete: Restrict, onUpdate: NoAction)
  selectedOptionIds Json         @default("[]")
  text              String?      @db.Text
  isCorrect         Boolean?
  revision          Int          @default(1)
  submittedAt       DateTime     @default(now()) @db.Timestamptz(6)

  @@unique([attemptId, questionId])
  @@index([questionId, versionId])
}
