enum AttemptStatus {
  IN_PROGRESS
  ABANDONED
  COMPLETED
}

model QuizAttempt {
  attemptNumber Int?
  focusedReview Boolean @default(false)
  typeMetrics QuizAttemptTypeMetric[]
  scoreRatio Float?
  elapsedMs Int?
  completedDay DateTime? @db.Date
  lastQuestionIndex Int @default(0)
  inputHash      String              @default("") @db.VarChar(64)
  id             String              @id @default(uuid()) @db.Uuid
  versionId      String              @db.Uuid
  version        QuizVersion         @relation(fields: [versionId], references: [id], onDelete: Restrict)
  requestKey     String              @db.VarChar(128)
  mode           QuizMode
  status         AttemptStatus       @default(IN_PROGRESS)
  questionOrder  Json                @default("[]")
  optionOrder    Json                @default("{}")
  startedAt      DateTime            @default(now()) @db.Timestamptz(6)
  finishedAt     DateTime?           @db.Timestamptz(6)
  correctCount   Int?
  answeredCount  Int?
  totalQuestions Int
  answers        QuizAttemptAnswer[]

  @@unique([versionId, requestKey])
  @@unique([id, versionId])
  @@index([versionId, startedAt, id])
  @@index([status, startedAt])
  @@index([status, finishedAt, id])
  @@index([status, completedDay, versionId])
}
