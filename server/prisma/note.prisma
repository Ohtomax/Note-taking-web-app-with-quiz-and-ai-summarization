model Note {
  quizSources          QuizSource[]
  summarySources       SummarySource[]
  id                   String          @id @default(uuid()) @db.Uuid
  projectId            String          @db.Uuid
  project              Project         @relation(fields: [projectId], references: [id], onDelete: Restrict)
  title                String          @db.VarChar(200)
  content              Json            @default("{}")
  contentSchemaVersion Int             @default(1)
  plainText            String          @default("") @db.Text
  revision             Int             @default(1)
  pinned               Boolean         @default(false)
  archivedAt           DateTime?       @db.Timestamptz(6)
  deletedAt            DateTime?       @db.Timestamptz(6)
  lastOpenedAt         DateTime?       @db.Timestamptz(6)
  createdAt            DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @db.Timestamptz(6)

  @@index([projectId, deletedAt, pinned, updatedAt, id])
  @@index([projectId, title, id])
  @@index([projectId, createdAt, id])
}
