enum Difficulty {
  EASY
  MEDIUM
  HARD
  MIXED
}

enum QuizMode {
  PRACTICE
  EXAM
}

model QuizVersion {
  attempts            QuizAttempt[]
  id                  String         @id @default(uuid()) @db.Uuid
  quizId              String         @db.Uuid
  quiz                Quiz           @relation(fields: [quizId], references: [id], onDelete: Restrict)
  version             Int
  difficulty          Difficulty
  defaultMode         QuizMode       @default(PRACTICE)
  includeExplanations Boolean        @default(true)
  generatedAt         DateTime       @default(now()) @db.Timestamptz(6)
  promptVersion       String         @db.VarChar(50)
  sources             QuizSource[]
  questions           QuizQuestion[]

  @@unique([quizId, version])
}
