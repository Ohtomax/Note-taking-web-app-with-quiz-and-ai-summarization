PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

DATABASE_URL=
# Explicit migration runner only; omit from the deployed web service.
DIRECT_URL=
DATABASE_CA_PATH=
# Render Free uses 2; the local default remains 5.
DB_POOL_MAX=5
FIREBASE_SERVICE_ACCOUNT=
REDIS_URL=

# Current adapter: Groq. Gemini needs a separate provider integration.
AI_ENABLED=false
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
# Render Free uses 1; the database enforces admission across API instances.
AI_GLOBAL_CONCURRENCY=4
# Other quota/source/deadline settings are code policies, not env inputs.
