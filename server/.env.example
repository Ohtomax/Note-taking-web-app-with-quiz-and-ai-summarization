PORT=3001
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173
TRUST_PROXY_HOPS=0

DATABASE_URL=
# Explicit migration runner only; omit from the deployed web service.
DIRECT_URL=
DATABASE_CA_PATH=
# Render Free uses 2; the local default remains 5.
DB_POOL_MAX=5
FIREBASE_SERVICE_ACCOUNT=
REDIS_URL=

# Set AI_API_KEY to a server-side Google AI Studio Gemini API key before enabling.
AI_ENABLED=false
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
# Render Free uses 1; the database enforces admission across API instances.
AI_GLOBAL_CONCURRENCY=4
# Other quota/source/deadline settings are code policies, not env inputs.
