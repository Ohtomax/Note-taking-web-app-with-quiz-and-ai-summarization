# Phase 1 bootstrap reads PORT only. Other fields become required in later phases.
PORT=3001
NODE_ENV=development
# Phase 2 API security, SQL, Firebase and Redis
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://APP_USER:PASSWORD@HOST:6543/postgres?sslmode=verify-full
DIRECT_URL=postgresql://MIGRATION_USER:PASSWORD@HOST:5432/postgres?sslmode=verify-full
DATABASE_CA_PATH=./certs/prod-ca-2021.crt
FIREBASE_SERVICE_ACCOUNT=
REDIS_URL=redis://localhost:6379
# Phase 4 generation. Supply the selected account's model and key later.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
AI_DAILY_GENERATIONS=20
AI_USER_CONCURRENCY=1
AI_GLOBAL_CONCURRENCY=4
AI_CALL_TIMEOUT_MS=20000
AI_TOTAL_TIMEOUT_MS=55000
AI_MAX_SOURCE_TOKENS=100000
