# Local health startup works with blank infrastructure settings. Production requires them.
PORT=3001
NODE_ENV=development
# Phase 2 API security, SQL, Firebase and Redis
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=
DIRECT_URL=
DATABASE_CA_PATH=
FIREBASE_SERVICE_ACCOUNT=
REDIS_URL=
# Phase 4 generation. Supply the selected account's model and key later.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-120b
AI_API_KEY=
AI_DAILY_GENERATIONS=20
AI_USER_CONCURRENCY=1
AI_GLOBAL_CONCURRENCY=4
AI_CALL_TIMEOUT_MS=20000
AI_TOTAL_TIMEOUT_MS=55000
AI_MAX_SOURCE_TOKENS=100000

# Set the exact trusted proxy count for your hosting topology. Default trusts no proxy.
TRUST_PROXY_HOPS=0
