# Allow only build inputs. Render also puts secret files in the context root.
**
!package.json
!package-lock.json
!tsconfig.json
!prisma.config.ts
!server.ts
!prisma/
!prisma/**
!config/
!config/**
!src/
!src/**
!certs/
!certs/**
src/generated/
# Keep accidental secrets out even when placed below an allowed source folder.
**/.env
**/.env.*
**/*.pem
**/*.key
**/*serviceAccount*.json
**/*service-account*.json
# Block .crt files everywhere EXCEPT the certs/ directory
src/**/*.crt
config/**/*.crt
prisma/**/*.crt
