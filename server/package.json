{
  "name": "study-platform-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "build": "prisma generate && tsc && tsc-alias -f",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"config/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js,json,html}\" --ignore-unknown",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"config/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,js,json,html}\" --ignore-unknown",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:db": "node --import tsx --test --test-concurrency=1 tests/database/*.test.ts",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "postinstall": "prisma generate",
    "prisma:migrate": "node --env-file-if-exists=.env node_modules/prisma/build/index.js migrate dev",
    "db:push": "node --env-file-if-exists=.env node_modules/prisma/build/index.js db push"
  },
  "dependencies": {
    "@ai-sdk/openai": "1.3.24",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "ai": "4.3.19",
    "cors": "2.8.6",
    "express": "4.22.3",
    "express-rate-limit": "8.7.5",
    "firebase-admin": "14.5.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "rate-limit-redis": "4.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/cors": "2.8.19",
    "@types/express": "4.17.25",
    "@types/node": "24.19.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "6.0.3",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "prisma": "7.10.1",
    "supertest": "7.3.2",
    "tsc-alias": "1.9.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
