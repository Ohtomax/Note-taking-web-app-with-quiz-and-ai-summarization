{
  "name": "study-platform-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "dev": "tsx watch server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.tests.json",
    "build": "tsc && tsc-alias -f",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json,html}\" --ignore-unknown",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"*.{ts,js,json,html}\" --ignore-unknown",
    "test": "node --import tsx --test tests/*.test.ts"
  },
  "dependencies": {
    "express": "4.22.3"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "4.17.25",
    "@types/node": "24.19.4",
    "@types/supertest": "6.0.3",
    "eslint": "10.15.0",
    "globals": "16.5.0",
    "prettier": "3.10.1",
    "supertest": "7.3.2",
    "tsc-alias": "1.9.11",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0"
  }
}
